/* Light Theme for Hello KSP Launcher
 * 半透明版本:侧边栏、启动栏、卡片、分组等面板背景为半透明,
 * 让背景图透出显示。输入控件、按钮等保持不透明以保证可读性。 */

QWidget {
    background-color: transparent;
    color: #1e1e1e;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: transparent;
}

#backgroundLabel {
    background: transparent;
    border: none;
}

#contentContainer {
    background: transparent;
}

/* Sidebar - 65% 不透明 (浅灰) */
#sidebarWidget {
    background-color: rgba(243, 243, 243, 204);
    border: none;
}

#sidebarTitle {
    color: #1e1e1e;
    font-size: 12pt;
    font-weight: bold;
    padding: 10px;
}

#sidebarSectionLabel {
    color: #5a5a5a;
    font-size: 9pt;
    padding: 8px 15px 4px 15px;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    color: #1e1e1e;
    text-align: left;
    padding: 10px 15px;
    border-left: 3px solid transparent;
    icon-size: 18px 18px;
}

QPushButton#navButton:hover {
    background-color: rgba(232, 232, 232, 200);
    color: #000000;
}

QPushButton#navButton:checked {
    background-color: rgba(224, 224, 224, 220);
    color: #000000;
    border-left: 3px solid #0078d4;
}

/* Back button */
QPushButton#backButton {
    background-color: transparent;
    border: none;
    color: #1e1e1e;
    padding: 8px;
    font-size: 16pt;
    icon-size: 18px 18px;
}

QPushButton#backButton:hover {
    background-color: rgba(232, 232, 232, 200);
    color: #000000;
    border-radius: 4px;
}

/* Content area */
#contentStack {
    background-color: transparent;
}

#pageTitle {
    color: #1e1e1e;
    font-size: 14pt;
    font-weight: bold;
    padding: 15px;
}

#pageTopBar {
    background-color: transparent;
}

/* Instance list */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: rgba(243, 243, 243, 200);
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #c1c1c1;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 实例项卡片 - 75% 不透明 */
QWidget#instanceItem {
    background-color: rgba(243, 243, 243, 191);
    border-radius: 6px;
    margin: 4px 10px;
}

QWidget#instanceItem:hover {
    background-color: rgba(232, 232, 232, 204);
}

QWidget#instanceItem[selected="true"] {
    background-color: rgba(204, 228, 247, 220);
    border: 1px solid #0078d4;
}

QLabel#instanceName {
    color: #1e1e1e;
    font-size: 11pt;
    font-weight: bold;
}

QLabel#instancePath {
    color: #5a5a5a;
    font-size: 9pt;
}

QCheckBox#instanceCheckbox {
    spacing: 8px;
}

QCheckBox#instanceCheckbox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #969696;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox#instanceCheckbox::indicator:hover {
    border-color: #0078d4;
}

QCheckBox#instanceCheckbox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    image: none;
}

QPushButton#instanceMenuButton {
    background-color: transparent;
    border: none;
    color: #5a5a5a;
    padding: 5px 10px;
    font-size: 14pt;
    border-radius: 4px;
}

QPushButton#instanceMenuButton:hover {
    background-color: rgba(208, 208, 208, 220);
    color: #1e1e1e;
}

/* Add instance button */
QPushButton#addInstanceButton {
    background-color: #0078d4;
    border: none;
    color: #ffffff;
    border-radius: 6px;
    padding: 10px;
    margin: 4px 10px;
    font-size: 20pt;
}

QPushButton#addInstanceButton:hover {
    background-color: #106ebe;
}

/* Launch bar - 65% 不透明 (浅灰) */
#launchBar {
    background-color: rgba(243, 243, 243, 204);
    border-top: 1px solid rgba(224, 224, 224, 180);
}

QPushButton#launchButton {
    background-color: #0078d4;
    border: none;
    color: #ffffff;
    border-radius: 6px;
    padding: 12px 30px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton#launchButton:hover {
    background-color: #106ebe;
}

QPushButton#launchButton:pressed {
    background-color: #005a9e;
}

QPushButton#launchButton:disabled {
    background-color: #cccccc;
    color: #666666;
}

QPushButton#launchSwitchButton {
    background-color: rgba(224, 224, 224, 230);
    border: none;
    color: #1e1e1e;
    border-radius: 6px;
    padding: 12px 15px;
    font-size: 12pt;
}

QPushButton#launchSwitchButton:hover {
    background-color: rgba(208, 208, 208, 230);
}

QLabel#currentInstanceLabel {
    color: #1e1e1e;
    font-size: 10pt;
}

/* Settings page */
QGroupBox {
    background-color: rgba(255, 255, 255, 191);
    border: 1px solid rgba(208, 208, 208, 150);
    border-radius: 6px;
    margin-top: 15px;
    padding-top: 15px;
    font-weight: bold;
    color: #1e1e1e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 5px;
    background-color: transparent;
}

QLabel#settingLabel {
    color: #1e1e1e;
}

QLabel#settingHint {
    color: #5a5a5a;
    font-size: 9pt;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #969696;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1e1e1e;
}
QComboBox:hover {
    border-color: #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #969696;
    selection-background-color: #cce4f7;
    selection-color: #1e1e1e;
    color: #1e1e1e;
}

/* Instance detail sidebar tabs */
QPushButton#detailNavButton {
    background-color: transparent;
    border: none;
    color: #1e1e1e;
    text-align: left;
    padding: 10px 15px;
    border-left: 3px solid transparent;
    icon-size: 18px 18px;
}

QPushButton#detailNavButton:hover {
    background-color: rgba(232, 232, 232, 200);
    color: #000000;
}

QPushButton#detailNavButton:checked {
    background-color: rgba(224, 224, 224, 220);
    color: #000000;
    border-left: 3px solid #0078d4;
}

/* Settings list in game settings */
QTreeWidget {
    background-color: rgba(255, 255, 255, 191);
    border: 1px solid rgba(208, 208, 208, 150);
    border-radius: 6px;
    alternate-background-color: rgba(248, 248, 248, 180);
    color: #1e1e1e;
}

QTreeWidget::item {
    padding: 5px;
}

QTreeWidget::item:selected {
    background-color: #cce4f7;
    color: #1e1e1e;
}

/* 模组详情四 tab（元数据/文件/关系/版本）：半透明主题面板 + 选中高亮 */
QTabWidget#modDetailTabs::pane {
    background-color: rgba(248, 248, 248, 205);
    border: 1px solid rgba(206, 206, 206, 170);
    border-radius: 0 6px 6px 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: rgba(240, 240, 240, 185);
    color: #555555;
    padding: 7px 16px;
    border: 1px solid transparent;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: rgba(230, 230, 230, 205);
    color: #111111;
}

QTabBar::tab:selected {
    background-color: #0e639c;
    color: #ffffff;
}

QTabWidget#modDetailTabs QTextEdit {
    background-color: rgba(253, 253, 253, 220);
    border: none;
    color: #1e1e1e;
}

QHeaderView::section {
    background-color: rgba(243, 243, 243, 220);
    color: #1e1e1e;
    border: none;
    padding: 8px;
    border-right: 1px solid rgba(224, 224, 224, 150);
}

/* DLC and Mod lists */
QListWidget {
    background-color: rgba(255, 255, 255, 191);
    border: 1px solid rgba(208, 208, 208, 150);
    border-radius: 6px;
    color: #1e1e1e;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid rgba(224, 224, 224, 120);
}

QListWidget::item:selected {
    background-color: #cce4f7;
    color: #1e1e1e;
}

/* Mods table: transparent rows, only selection highlighted */
QTableView {
    background-color: transparent;
    alternate-background-color: transparent;
    border: none;
    color: #1e1e1e;
    selection-background-color: transparent;
    selection-color: #1e1e1e;
}

QTableView::viewport {
    background-color: transparent;
}

QTableView::item {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QTableView::item:selected {
    background-color: #cce4f7;
    color: #1e1e1e;
}

QTableView::item:hover {
    background-color: rgba(224, 224, 224, 160);
}

/* Mods management area: translucent panel like the detail sidebar */
#modsContentWidget {
    background-color: rgba(243, 243, 243, 204);
    border-radius: 8px;
}

/* Menu for instance actions */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 5px 0px;
}

QMenu::item {
    padding: 8px 25px;
    color: #333333;
}

QMenu::item:selected {
    background-color: #cce4f7;
    color: #1e1e1e;
}

/* Input dialog */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #969696;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1e1e1e;
}

QLineEdit:focus {
    border-color: #0078d4;
}

QLineEdit:read-only {
    background-color: rgba(240, 240, 240, 200);
}

QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #969696;
    border-radius: 4px;
    padding: 6px 15px;
    color: #1e1e1e;
    icon-size: 16px 16px;
}

QPushButton:hover {
    background-color: #d0d0d0;
}

QPushButton:pressed {
    background-color: #b8b8b8;
}

QPushButton#primaryButton {
    background-color: #0078d4;
    border: none;
    color: #ffffff;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #106ebe;
}

QDialog {
    background-color: #f3f3f3;
}

QLabel#dlcInstalled {
    color: #107c10;
}

QLabel#dlcNotInstalled {
    color: #d13438;
}

/* Icon only button */
QPushButton#iconButton {
    background-color: transparent;
    border: none;
    color: #1e1e1e;
    border-radius: 4px;
    padding: 6px;
    icon-size: 18px 18px;
}

QPushButton#iconButton:hover {
    background-color: rgba(224, 224, 224, 220);
}

/* 背景预览标签 */
QLabel#backgroundPreview {
    background-color: rgba(230, 230, 230, 180);
    border: 1px solid rgba(180, 180, 180, 150);
    border-radius: 4px;
}

/* Home page info frame - 通过 state 动态属性切换 */
QFrame#homeInfoFrame {
    background-color: rgba(255, 255, 255, 191);
    border: 1px solid rgba(208, 208, 208, 150);
    border-radius: 8px;
}

QFrame#homeInfoFrame[state="ok"] {
    background-color: rgba(0, 120, 215, 80);
    border: 1px solid rgba(0, 120, 215, 150);
}

QFrame#homeInfoFrame[state="warn"] {
    background-color: rgba(215, 60, 0, 80);
    border: 1px solid rgba(215, 60, 0, 150);
}

QFrame#homeInfoFrame[state="empty"] {
    background-color: rgba(200, 200, 200, 120);
}

/* Page panel - 页面大容器的半透明背板,风格对齐边栏 (≈65% 不透明) */
QFrame#pagePanel {
    background-color: rgba(243, 243, 243, 204);
    border: 1px solid rgba(224, 224, 224, 180);
    border-radius: 10px;
}
