/* Dark Theme for Hello KSP Launcher
 * 半透明版本:侧边栏、启动栏、卡片、分组等面板背景为 65% 不透明,
 * 让背景图透出显示。输入控件、按钮等保持不透明以保证可读性。 */

QWidget {
    background-color: transparent;
    color: #e0e0e0;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: transparent;
}

/* 背景 QLabel 不需要任何样式 */
#backgroundLabel {
    background: transparent;
    border: none;
}

/* 内容容器透明,让背景图透出 */
#contentContainer {
    background: transparent;
}

/* Sidebar - 65% 不透明 */
#sidebarWidget {
    background-color: rgba(37, 37, 38, 165);
    border: none;
}

#sidebarTitle {
    color: #ffffff;
    font-size: 12pt;
    font-weight: bold;
    padding: 10px;
}

#sidebarSectionLabel {
    color: #c8c8c8;
    font-size: 9pt;
    padding: 8px 15px 4px 15px;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    color: #ffffff;
    text-align: left;
    padding: 10px 15px;
    border-left: 3px solid transparent;
    icon-size: 18px 18px;
}

QPushButton#navButton:hover {
    background-color: rgba(58, 58, 62, 180);
    color: #ffffff;
}

QPushButton#navButton:checked {
    background-color: rgba(55, 55, 61, 220);
    color: #ffffff;
    border-left: 3px solid #007acc;
}

/* Back button */
QPushButton#backButton {
    background-color: transparent;
    border: none;
    color: #ffffff;
    padding: 8px;
    font-size: 16pt;
    icon-size: 18px 18px;
}

QPushButton#backButton:hover {
    background-color: rgba(58, 58, 62, 180);
    color: #ffffff;
    border-radius: 4px;
}

/* Content area - 完全透明,显示背景图 */
#contentStack {
    background-color: transparent;
}

#pageTitle {
    color: #ffffff;
    font-size: 14pt;
    font-weight: bold;
    padding: 15px;
}

#pageTopBar {
    background-color: transparent;
}

/* Instance list */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: rgba(45, 45, 48, 180);
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #4a4a4a;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5a5a5a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 实例项卡片 - 75% 不透明 */
QWidget#instanceItem {
    background-color: rgba(45, 45, 48, 191);
    border-radius: 6px;
    margin: 4px 10px;
}

QWidget#instanceItem:hover {
    background-color: rgba(51, 51, 55, 204);
}

QWidget#instanceItem[selected="true"] {
    background-color: rgba(9, 71, 113, 220);
    border: 1px solid #007acc;
}

QLabel#instanceName {
    color: #ffffff;
    font-size: 11pt;
    font-weight: bold;
}

QLabel#instancePath {
    color: #c8c8c8;
    font-size: 9pt;
}

QCheckBox#instanceCheckbox {
    spacing: 8px;
}

QCheckBox#instanceCheckbox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #555555;
    border-radius: 3px;
    background-color: #3c3c3c;
}

QCheckBox#instanceCheckbox::indicator:hover {
    border-color: #007acc;
}

QCheckBox#instanceCheckbox::indicator:checked {
    background-color: #007acc;
    border-color: #007acc;
    image: none;
}

QPushButton#instanceMenuButton {
    background-color: transparent;
    border: none;
    color: #c8c8c8;
    padding: 5px 10px;
    font-size: 14pt;
    border-radius: 4px;
}

QPushButton#instanceMenuButton:hover {
    background-color: rgba(60, 60, 60, 200);
    color: #ffffff;
}

/* Add instance button */
QPushButton#addInstanceButton {
    background-color: #0e639c;
    border: none;
    color: #ffffff;
    border-radius: 6px;
    padding: 10px;
    margin: 4px 10px;
    font-size: 20pt;
}

QPushButton#addInstanceButton:hover {
    background-color: #1177bb;
}

/* Launch bar - 65% 不透明 */
#launchBar {
    background-color: rgba(37, 37, 38, 204);
    border-top: 1px solid rgba(62, 62, 66, 150);
}

QPushButton#launchButton {
    background-color: #0e639c;
    border: none;
    color: #ffffff;
    border-radius: 6px;
    padding: 12px 30px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton#launchButton:hover {
    background-color: #1177bb;
}

QPushButton#launchButton:pressed {
    background-color: #0a4c78;
}

QPushButton#launchButton:disabled {
    background-color: #555555;
    color: #aaaaaa;
}

QPushButton#launchSwitchButton {
    background-color: rgba(60, 60, 60, 220);
    border: none;
    color: #ffffff;
    border-radius: 6px;
    padding: 12px 15px;
    font-size: 12pt;
}

QPushButton#launchSwitchButton:hover {
    background-color: rgba(74, 74, 74, 230);
}

QLabel#currentInstanceLabel {
    color: #e0e0e0;
    font-size: 10pt;
}

/* Settings page */
QGroupBox {
    background-color: rgba(45, 45, 48, 191);
    border: 1px solid rgba(62, 62, 66, 150);
    border-radius: 6px;
    margin-top: 15px;
    padding-top: 15px;
    font-weight: bold;
    color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 5px;
    background-color: transparent;
}

QLabel#settingLabel {
    color: #e0e0e0;
}

QLabel#settingHint {
    color: #a0a0a0;
    font-size: 9pt;
}

QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 10px;
    color: #ffffff;
}
QComboBox:hover {
    border-color: #007acc;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #2d2d30;
    border: 1px solid #555555;
    selection-background-color: #094771;
    selection-color: #ffffff;
    color: #ffffff;
}

/* Instance detail sidebar tabs */
QPushButton#detailNavButton {
    background-color: transparent;
    border: none;
    color: #ffffff;
    text-align: left;
    padding: 10px 15px;
    border-left: 3px solid transparent;
    icon-size: 18px 18px;
}

QPushButton#detailNavButton:hover {
    background-color: rgba(58, 58, 62, 180);
    color: #ffffff;
}

QPushButton#detailNavButton:checked {
    background-color: rgba(55, 55, 61, 220);
    color: #ffffff;
    border-left: 3px solid #007acc;
}

/* Settings list in game settings */
QTreeWidget {
    background-color: rgba(37, 37, 38, 191);
    border: 1px solid rgba(62, 62, 66, 150);
    border-radius: 6px;
    alternate-background-color: rgba(45, 45, 48, 180);
    color: #e0e0e0;
}

QTreeWidget::item {
    padding: 5px;
}

QTreeWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* 模组详情四 tab（元数据/文件/关系/版本）：半透明主题面板 + 选中高亮 */
QTabWidget#modDetailTabs::pane {
    background-color: rgba(37, 37, 38, 170);
    border: 1px solid rgba(62, 62, 66, 150);
    border-radius: 0 6px 6px 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: rgba(45, 45, 48, 150);
    color: #b8b8b8;
    padding: 7px 16px;
    border: 1px solid transparent;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: rgba(58, 58, 62, 170);
    color: #ffffff;
}

QTabBar::tab:selected {
    background-color: #0e639c;
    color: #ffffff;
}

QTabWidget#modDetailTabs QTextEdit {
    background-color: rgba(45, 45, 48, 180);
    border: none;
    color: #e0e0e0;
}

QHeaderView::section {
    background-color: rgba(51, 51, 55, 200);
    color: #ffffff;
    border: none;
    padding: 8px;
    border-right: 1px solid rgba(62, 62, 66, 150);
}

/* DLC and Mod lists */
QListWidget {
    background-color: rgba(37, 37, 38, 191);
    border: 1px solid rgba(62, 62, 66, 150);
    border-radius: 6px;
    color: #e0e0e0;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid rgba(62, 62, 66, 120);
}

QListWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* Mods table: transparent rows, only selection highlighted */
QTableView {
    background-color: transparent;
    alternate-background-color: transparent;
    border: none;
    color: #e0e0e0;
    selection-background-color: transparent;
    selection-color: #ffffff;
}

QTableView::viewport {
    background-color: transparent;
}

QTableView::item {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QTableView::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QTableView::item:hover {
    background-color: rgba(58, 58, 62, 120);
}

/* Mods management area: translucent panel like the detail sidebar */
#modsContentWidget {
    background-color: rgba(37, 37, 38, 165);
    border-radius: 8px;
}

/* Menu for instance actions */
QMenu {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 6px;
    padding: 5px 0px;
}

QMenu::item {
    padding: 8px 25px;
    color: #cccccc;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* Input dialog */
QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 10px;
    color: #ffffff;
}

QLineEdit:focus {
    border-color: #007acc;
}

QLineEdit:read-only {
    background-color: rgba(60, 60, 60, 180);
}

QPushButton {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 15px;
    color: #ffffff;
    icon-size: 16px 16px;
}

QPushButton:hover {
    background-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

QPushButton#primaryButton {
    background-color: #0e639c;
    border: none;
    color: #ffffff;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #1177bb;
}

QDialog {
    background-color: #252526;
}

QLabel#dlcInstalled {
    color: #4ec9b0;
}

QLabel#dlcNotInstalled {
    color: #f44747;
}

/* Icon only button */
QPushButton#iconButton {
    background-color: transparent;
    border: none;
    color: #ffffff;
    border-radius: 4px;
    padding: 6px;
    icon-size: 18px 18px;
}

QPushButton#iconButton:hover {
    background-color: rgba(60, 60, 60, 200);
}

/* 背景预览标签 */
QLabel#backgroundPreview {
    background-color: rgba(30, 30, 30, 150);
    border: 1px solid rgba(62, 62, 66, 150);
    border-radius: 4px;
}

/* Home page info frame - 通过 state 动态属性切换 */
QFrame#homeInfoFrame {
    background-color: rgba(45, 45, 48, 191);
    border: 1px solid rgba(62, 62, 66, 150);
    border-radius: 8px;
}

QFrame#homeInfoFrame[state="ok"] {
    background-color: rgba(0, 120, 215, 80);
    border: 1px solid rgba(0, 120, 215, 150);
}

QFrame#homeInfoFrame[state="warn"] {
    background-color: rgba(215, 60, 0, 80);
    border: 1px solid rgba(215, 60, 0, 150);
}

QFrame#homeInfoFrame[state="empty"] {
    background-color: rgba(60, 60, 60, 100);
}

/* Page panel - 页面大容器的半透明背板,风格对齐边栏 (≈65% 不透明) */
QFrame#pagePanel {
    background-color: rgba(37, 37, 38, 204);
    border: 1px solid rgba(62, 62, 66, 150);
    border-radius: 10px;
}

/* 实例管理详情页顶部返回+标题：半透明底，便于在背景图上清晰显示 */
QWidget#instanceDetailPage QPushButton#backButton {
    background-color: rgba(45, 45, 48, 165);
    border: none;
    border-radius: 6px;
    color: #ffffff;
    padding: 8px 12px;
}
QWidget#instanceDetailPage QPushButton#backButton:hover {
    background-color: rgba(58, 58, 62, 190);
}
QWidget#instanceDetailPage QLabel#pageTitle {
    background-color: rgba(45, 45, 48, 165);
    border-radius: 6px;
    padding: 8px 14px;
    color: #ffffff;
    font-size: 13pt;
    font-weight: bold;
}

/* 存档管理页顶部返回+标题：半透明底，与详情页一致 */
QWidget#savesListPage QPushButton#backButton {
    background-color: rgba(45, 45, 48, 165);
    border: none;
    border-radius: 6px;
    color: #ffffff;
    padding: 8px 12px;
}
QWidget#savesListPage QPushButton#backButton:hover {
    background-color: rgba(58, 58, 62, 190);
}
QWidget#savesListPage QLabel#pageTitle {
    background-color: rgba(45, 45, 48, 165);
    border-radius: 6px;
    padding: 8px 14px;
    color: #ffffff;
    font-size: 13pt;
    font-weight: bold;
}
